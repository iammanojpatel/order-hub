{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: FastAPI (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}/backend/src" },
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Backend: pytest current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x", "-q", "-p", "no:cacheprovider"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Web: Next.js server (RSC, Server Actions)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Web: browser (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000/products",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "Web: Vitest current file",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/node_modules/vitest/vitest.mjs",
      "args": ["run", "${file}", "--no-coverage", "--no-file-parallelism"],
      "cwd": "${workspaceFolder}/frontend",
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full stack: API + Next.js + Chrome",
      "configurations": [
        "API: FastAPI (debug)",
        "Web: Next.js server (RSC, Server Actions)",
        "Web: browser (Chrome)"
      ],
      "stopAll": true
    }
  ]
}
